import Button from "./Button.astro";
import logo from "../assets/logo-totalcross.png";

const links = [
  ["Why TotalCross", "/why-totalcross/"],
  ["Licensing", "/licensing/"],
  ["Docs", "https://learn.totalcross.com/?utm_source=site&utm_medium=principal"],
  ["Community", "/community/"],
  ["Blog", "/blog/"],
  ["Services", "/services/"],
];
---

<header class="site-header">
  <nav class="navigation container" aria-label="Primary navigation">
    <a class="logo" href="/" aria-label="TotalCross home">
      <img src={logo.src} alt="TotalCross" width="135" height="30" />
    </a>

    <div class="desktop-links">
      {links.map(([label, href]) => <a href={href}>{label}</a>)}
    </div>

    <div class="desktop-actions">
      <a class="github" href="https://github.com/TotalCross/totalcross" aria-label="TotalCross on GitHub">
        <svg aria-hidden="true" viewBox="0 0 24 24" width="25" height="25">
          <path fill="currentColor" d="M12 .7a11.5 11.5 0 0 0-3.6 22.4c.6.1.8-.2.8-.6v-2.2c-3.3.7-4-1.4-4-1.4-.5-1.4-1.3-1.7-1.3-1.7-1.1-.8.1-.8.1-.8 1.2.1 1.8 1.2 1.8 1.2 1.1 1.8 2.8 1.3 3.5 1 .1-.8.4-1.3.8-1.6-2.7-.3-5.5-1.3-5.5-5.7 0-1.3.5-2.3 1.2-3.1-.1-.3-.5-1.6.1-3.1 0 0 1-.3 3.2 1.2a11 11 0 0 1 5.8 0c2.2-1.5 3.2-1.2 3.2-1.2.6 1.5.2 2.8.1 3.1.8.8 1.2 1.8 1.2 3.1 0 4.4-2.8 5.4-5.5 5.7.4.4.8 1.1.8 2.2v3.3c0 .4.2.7.8.6A11.5 11.5 0 0 0 12 .7Z" />
        </svg>
      </a>
      <Button href="/get-started/" label="Get started" />
    </div>

    <details class="mobile-menu">
      <summary aria-label="Open navigation"><span></span></summary>
      <div class="mobile-links">
        {links.map(([label, href]) => <a href={href}>{label}</a>)}
        <a href="/get-started/">Get started</a>
      </div>
    </details>
  </nav>
</header>

<style>
  .site-header {
    background: var(--color-ink);
    border-bottom: 2px solid rgb(51 51 51 / 12%);
    color: var(--color-paper);
    position: relative;
    z-index: 10;
  }

  .navigation {
    align-items: center;
    display: flex;
    height: 63px;
    justify-content: space-between;
  }

  .logo {
    flex: 0 0 135px;
  }

  .logo img {
    height: 30px;
    object-fit: contain;
    width: 135px;
  }

  .desktop-links,
  .desktop-actions {
    align-items: center;
    display: flex;
  }

  .desktop-links {
    gap: clamp(1rem, 2vw, 2rem);
    margin-left: clamp(6rem, 12vw, 11rem);
  }

  .desktop-links a {
    color: var(--color-paper);
    font-size: 0.82rem;
    font-weight: 500;
    text-decoration: none;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .desktop-links a:hover,
  .desktop-links a:focus-visible,
  .github:hover,
  .github:focus-visible {
    color: var(--color-brand-green);
  }

  .desktop-actions {
    gap: 1.6rem;
    margin-left: auto;
    padding-right: 2rem;
  }

  .github {
    color: var(--color-white);
  }

  .mobile-menu {
    display: none;
  }

  @media (max-width: 1000px) {
    .desktop-links,
    .desktop-actions {
      display: none;
    }

    .navigation {
      height: 68px;
    }

    .mobile-menu {
      display: block;
    }

    summary {
      cursor: pointer;
      height: 34px;
      list-style: none;
      position: relative;
      width: 34px;
    }

    summary::-webkit-details-marker {
      display: none;
    }

    summary::before,
    summary::after,
    summary span {
      background: #111;
      content: "";
      height: 3px;
      left: 2px;
      position: absolute;
      width: 30px;
    }

    summary::before { top: 6px; }
    summary span { top: 15px; }
    summary::after { top: 24px; }

    .mobile-links {
      background: var(--color-white);
      display: flex;
      flex-direction: column;
      left: 0;
      min-height: calc(100vh - 68px);
      padding: 3rem var(--page-gutter);
      position: absolute;
      right: 0;
      top: 68px;
    }

    .mobile-links a {
      color: var(--color-ink);
      font-size: 1.2rem;
      padding: 1rem 0;
      text-decoration: none;
      text-transform: uppercase;
    }
  }
</style>
