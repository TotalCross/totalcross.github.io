import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "./Button.astro";
import PageHero from "./PageHero.astro";
---
<BaseLayout title="Page not found · TotalCross" description="The requested TotalCross page could not be found.">
  <PageHero title="Page not found" tagline="The address may have changed, but the TotalCross site is still here." />
  <section class="page-content">
    <div class="container prose-wide not-found">
      <p>Use the navigation above or return to the home page.</p>
      <Button href="/" label="Go home" tone="dark" />
    </div>
  </section>
</BaseLayout>

<style>
  .not-found { text-align: center; }
</style>
