import BaseLayout from "../../layouts/BaseLayout.astro";
import Button from "../../components/Button.astro";
import PageHero from "../../components/PageHero.astro";
import licenseImage from "../../assets/licence.png";

const features = ["Unlimited developers", "Unlimited runtime", "Community support", "Linux Arm, Android, WinCE, Windows, Linux, and iOS targets", "Documentation and guidelines", "Video tutorials", "Forum"];
---
<BaseLayout title="Licensing · TotalCross" description="Understand the TotalCross LGPL v2.1 open-source license and commercial licensing option.">
  <PageHero title="Our Licenses" tagline="Choose the model that fits your TotalCross project." />
  <section class="page-content"><div class="container two-column">
    <div class="prose"><h3>TotalCross is LGPL v2.1</h3><p>TotalCross is open source under LGPL v2.1. Personal projects can use it freely. Distributed projects must make the use of TotalCross clear and comply with the LGPL source and notice requirements.</p><p>Changes to TotalCross itself must be made available under the license. Contributions that benefit the community are welcome upstream.</p></div>
    <article class="license-card"><h2>Free</h2><p>Under LGPL v2.1</p><ul>{features.map((feature) => <li>{feature}</li>)}</ul><Button href="/get-started/" label="Get started" /></article>
  </div></section>
  <section class="section section--white"><div class="container license-art"><img src={licenseImage.src} alt="TotalCross license illustration" /></div></section>
  <section class="section section--light"><div class="container prose-wide commercial"><h2>TotalCross also has a commercial license</h2><p>If the LGPL requirements do not fit your distribution model, contact us to discuss a commercial license.</p><Button href="/contact/" label="Contact us" tone="dark" /></div></section>
</BaseLayout>

<style>
  .license-card { background: var(--color-ink); border-radius: 20px; box-shadow: 0 3px 10px rgb(0 0 0 / 25%); color: var(--color-white); padding: 2.5rem; }
  .license-card h2 { color: var(--color-white); font-size: 2rem; margin: 0; text-transform: uppercase; }
  .license-card li { margin-bottom: 0.7rem; }
  .license-art { max-width: 820px; }
  .license-art img { width: 100%; }
  .commercial { text-align: center; }
</style>
