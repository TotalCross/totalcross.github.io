---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Button from "../../components/Button.astro";
import PageHero from "../../components/PageHero.astro";
import bytecode from "../../assets/whytotalcross_info.png";
import vm from "../../assets/whytotalcross_info2.png";
import resources from "../../assets/whytotalcross_info3.png";
import corona from "../../assets/whytotalcross_corona.png";
import ide from "../../assets/whytotalcross_ide.png";
import languages from "../../assets/whytotalcross_languages.png";
import fast from "../../assets/whytotalcross_fast.png";
---
<!--
SPDX-FileCopyrightText: 2026 Amalgam Solucoes em TI Ltda.
SPDX-License-Identifier: MIT
-->

<BaseLayout title="Why TotalCross" description="Low footprint, high productivity, and a familiar developer experience for embedded interfaces.">
  <PageHero title="Why TotalCross" tagline="Three important points that make the difference when programming." />
  <section class="page-content"><div class="container"><h2 class="section-title">Low-footprint applications: be light</h2><p class="section-subtitle">The 5MB runtime brings mobile-grade experiences even to low-end MPUs.</p><div class="feature-rows"><article class="two-column"><img src={bytecode.src} alt="TotalCross bytecode architecture" /><div class="prose"><h3>TotalCross Bytecode</h3><p>Java and Kotlin bytecode is converted into optimized TotalCross bytecode. Frequently used operations are compressed to reduce instruction assembly and footprint.</p></div></article><article class="two-column reverse"><div class="prose"><h3>TotalCross Virtual Machine</h3><p>The register-based TCVM completes common operations with fewer instructions than a stack-based virtual machine, helping deliver high performance.</p></div><img src={vm.src} alt="TotalCross virtual machine architecture" /></article><article class="two-column"><img src={resources.src} alt="TotalCross resource use" /><div class="prose"><h3>Run higher with fewer resources</h3><p>Make the most of constrained hardware while retaining a high-level programming model and responsive interface.</p></div></article></div></div></section>
  <section class="section section--white"><div class="container two-column"><img src={corona.src} alt="Coronavirus chart app built with TotalCross" /><div class="prose"><h3>Easy to use: raise your productivity</h3><p>The sample chart uses a public API and a compact TotalCross codebase to deliver an interactive embedded interface.</p><Button href="https://github.com/TotalCross/corona-chart-app" label="Check the code" tone="dark" /></div></div></section>
  <section class="page-content"><div class="container card-grid"><article class="info-card"><img src={ide.src} alt="" /><h3>Use your favorite IDE</h3><p>Work in VS Code, NetBeans, Eclipse, IntelliJ, or another Java-capable IDE.</p></article><article class="info-card"><img src={languages.src} alt="" /><h3>High-level languages</h3><p>Build with the supported Java subset or Kotlin subset provided by TotalCross.</p></article><article class="info-card"><img src={fast.src} alt="" /><h3>Fast to learn</h3><p>Follow the documentation and start developing in a few hours.</p></article></div></section>
</BaseLayout>

<style>
  .feature-rows { display: grid; gap: 6rem; margin-top: 5rem; }
  .feature-rows img { margin-inline: auto; max-height: 420px; object-fit: contain; }
  @media (max-width: 768px) { .reverse > :last-child { grid-row: 1; } }
</style>
