import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "../components/Button.astro";
import HomeHero from "../components/HomeHero.astro";
import background from "../assets/bghome_sitetc.png";
import waves from "../assets/bg_wavesdark.png";
import raspberry from "../assets/rasp_01.png";
import lowFootprint from "../assets/home_lowfootprint.png";
import gui from "../assets/home_gui.png";
import crossPlatform from "../assets/home_cross.png";
import requirements from "../assets/home_requirements.png";
import openSource from "../assets/home_opensource.png";
import embeddedPlatforms from "../assets/home_raspberry.png";
import homeApp from "../assets/home_homeapp.png";
import printer from "../assets/home_printer.png";
import coffee from "../assets/home_coffee.png";
import tecdet from "../assets/home_tecdet.png";
import tecdetLogo from "../assets/home_tecdetlogo.png";
import getStarted from "../assets/home_gsbanner.png";

const features = [
  [lowFootprint.src, "Low Footprint", "Less than 5MB of footprint, ensuring high performance even when running on low-end devices."],
  [gui.src, "Fast to Use GUI Creator", "Basic knowledge of Java or Kotlin lets you build performing apps for Android, Linux Arm, Windows and iOS."],
  [crossPlatform.src, "Cross-Platform", "Code once and run on every platform, with responsive user interfaces providing the same behavior and usability."],
  [requirements.src, "Minimum Requirements", "256MB RAM, Arm A7 528MHz CPU and GPU."],
  [openSource.src, "Free & Open Source", "Hosted on GitHub and maintained by a community of contributors."],
  [embeddedPlatforms.src, "Supported Embedded Platforms", "Raspberry Pi, BeagleBone Black, Toradex Colibri, Verdin and Apalis."],
];

const description = "Build beautiful and modern graphical user interfaces for embedded, IoT, mobile and desktop devices with a cross-platform Java SDK.";
---

<BaseLayout title="TotalCross · GUI Creator for Embedded Devices" description={description}>
  <HomeHero background={background.src} image={raspberry.src} />

  <section class="section section--light features-section">
    <div class="container">
      <h2 class="section-title">Simplify the development of User Interfaces on Embedded Devices</h2>
      <div class="features">
        {features.map(([image, title, text]) => (
          <article class="feature">
            <img src={image} alt="" width="100" height="100" loading="lazy" />
            <h3>{title}</h3>
            <p>{text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--dark waves" style={`--waves: url(${waves.src})`}>
    <div class="container">
      <h2 class="section-title light-title">What is TotalCross?</h2>
      <div class="two-column">
        <img src={homeApp.src} alt="Home automation interface made with TotalCross" loading="lazy" />
        <div class="prose">
          <p>TotalCross is an open-source cross-platform SDK developed to make your life easier when creating mobile-grade user experiences for embedded systems.</p>
          <p>All while delivering native performance with a low footprint.</p>
          <Button href="/get-started/" label="Get started" tone="light" />
        </div>
      </div>
    </div>
  </section>

  <section class="section section--light">
    <div class="container">
      <h2 class="section-title">Samples</h2>
      <p class="section-subtitle">Wonderful User Interfaces for Embedded Devices</p>
      <div class="two-column samples">
        <article class="media-card">
          <img src={coffee.src} alt="Coffee machine interface made with TotalCross" loading="lazy" />
          <h3>Coffee Machine</h3>
          <p>Control the features of your machine and choose your coffee just the way you like it.</p>
        </article>
        <article class="media-card">
          <img src={printer.src} alt="Printer interface made with TotalCross" loading="lazy" />
          <h3>Printer</h3>
          <p>A clear embedded interface makes a printer smarter and easier to use.</p>
        </article>
      </div>
      <div class="center-button"><Button href="/samples/" label="Check our samples" tone="dark" /></div>
    </div>
  </section>

  <section class="section section--white">
    <div class="container two-column case-study">
      <div class="prose">
        <img class="customer-logo" src={tecdetLogo.src} alt="Tecdet" width="140" loading="lazy" />
        <h3>Built with TotalCross</h3>
        <p>Tecdet develops systems for traffic control and inspection for the Brazilian government.</p>
        <p>They rebuilt their system for Linux Arm on Toradex modules and chose TotalCross to develop the GUI.</p>
        <Button href="/traffic-control-system-by-tecdet/" label="Read the case" tone="dark" />
      </div>
      <img src={tecdet.src} alt="Tecdet traffic control system" loading="lazy" />
    </div>
  </section>

  <section class="section section--dark get-started">
    <div class="container two-column">
      <div class="prose">
        <h2>Ready to create your embedded interface?</h2>
        <p>Build and deploy your first TotalCross application with our documentation and open-source tools.</p>
        <Button href="/get-started/" label="Get started" tone="light" />
      </div>
      <img src={getStarted.src} alt="TotalCross embedded application" loading="lazy" />
    </div>
  </section>
</BaseLayout>

<style>
  .features-section {
    padding-top: 9rem;
  }

  .features {
    display: grid;
    gap: 3rem 4rem;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin-top: 4rem;
  }

  .feature img {
    height: 100px;
    object-fit: contain;
    object-position: left center;
    width: 100px;
  }

  .feature h3 {
    color: var(--color-ink-deep);
    font-size: 1.1rem;
    margin: 1rem 0 0.5rem;
  }

  .feature p {
    font-size: 0.9rem;
  }

  .waves {
    background-image: linear-gradient(rgb(33 33 33 / 83%), rgb(33 33 33 / 83%)), var(--waves);
    background-position: center;
    background-size: cover;
  }

  .light-title {
    color: var(--color-paper);
    margin-bottom: 4rem;
  }

  .samples {
    align-items: start;
  }

  .center-button {
    margin-top: 3rem;
    text-align: center;
  }

  .customer-logo {
    height: auto;
    margin-bottom: 1.5rem;
    width: 140px;
  }

  .case-study > img {
    width: 100%;
  }

  .get-started h2 {
    color: var(--color-paper);
    font-size: clamp(2rem, 4vw, 3rem);
  }

  .get-started img {
    justify-self: center;
    max-height: 420px;
    object-fit: contain;
  }

  @media (max-width: 900px) {
    .features {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 600px) {
    .features-section {
      padding-top: 4rem;
    }

    .features {
      grid-template-columns: 1fr;
      margin-top: 2rem;
    }

    .feature {
      text-align: center;
    }

    .feature img {
      margin-inline: auto;
    }

    .case-study > img {
      grid-row: 1;
    }
  }
</style>
