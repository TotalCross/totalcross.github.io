<BaseLayout title="Services · TotalCross" description="Support, interface engineering, and UI/UX services for TotalCross embedded projects.">
  <PageHero title="Our Services" tagline="Need extra hands? You can count on us." />
  <section class="page-content">
    <div class="container">
      <h2 class="section-title">Support for the TotalCross framework</h2>
      <p class="section-subtitle">Community content is always available, and enterprise support can help with demanding production work.</p>
      <div class="card-grid">
        <article class="info-card"><h3>Framework support</h3><p>Our team can help solve platform problems, implementation demands, and production issues.</p><Button href="/contact/" label="I want support" tone="dark" /></article>
        <article class="info-card"><h3>GUI creation</h3><p>Our engineers can build your graphical interface in record time and deliver it for your target device.</p><Button href="/contact/" label="Request a quote" tone="dark" /></article>
        <article class="info-card"><h3>Interface design</h3><p>Our designers bring a mobile-grade UI/UX to embedded projects that deserve an excellent user experience.</p><Button href="/contact/" label="Request a quote" tone="dark" /></article>
      </div>
    </div>
  </section>
  <section class="section section--dark"><div class="container callout"><h2>Need another kind of service?</h2><p>Tell us what you are looking for. We will help or refer you to one of our partners.</p><Button href="/contact/" label="Contact us" tone="light" /></div></section>
</BaseLayout>

<style>
  .callout { text-align: center; }
  .callout h2 { color: var(--color-white); font-size: clamp(2rem, 4vw, 2.8rem); }
</style>
