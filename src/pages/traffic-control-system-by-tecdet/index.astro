import { getEntry, render } from "astro:content";
import BlogArticle from "../../layouts/BlogArticle.astro";
import articleImage from "../../assets/tecdet.jpg";
import { getPublishedPosts, seriesFor, translationsFor } from "../../lib/content";

const post = await getEntry("blog", "traffic-control-system-by-tecdet");
if (!post || post.data.draft) throw new Error("Published Tecdet article not found");
const author = await getEntry(post.data.author);
if (!author) throw new Error("Tecdet author not found");
const { Content, headings } = await render(post);
const posts = await getPublishedPosts();
const translations = translationsFor(post, posts);
---
<BlogArticle post={post} author={author} headings={headings} translations={translations} seriesPosts={seriesFor(post, posts)} coverImage={articleImage}>
  <Content />
</BlogArticle>
