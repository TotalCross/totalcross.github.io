SPDX-License-Identifier: MIT
-->
<BaseLayout title={`${label} articles · TotalCross`} description={`TotalCross articles tagged ${label}.`}><PageHero title={`#${label}`} tagline="Articles from the TotalCross blog" /><section class="page-content"><div class="container prose-wide"><PostList items={items} /></div></section></BaseLayout>
