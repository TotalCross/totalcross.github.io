{
  "name": "totalcross-site",
  "private": true,
  "description": "Source for the TotalCross project website at totalcross.com.",
  "version": "1.0.0",
  "author": "TotalCross",
  "bugs": {
    "url": "https://github.com/TotalCross/totalcross.github.io/issues"
  },
  "dependencies": {
    "typeface-merriweather": "0.0.72",
    "typeface-montserrat": "0.0.75"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/mdx": "^7.0.5",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@fortawesome/free-brands-svg-icons": "7.3.1",
    "astro": "^7.2.0",
    "typescript": "^6.0.3"
  },
  "homepage": "https://totalcross.com",
  "keywords": [
    "astro",
    "embedded",
    "static-site",
    "totalcross"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TotalCross/totalcross.github.io.git"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "astro build && node scripts/prepare-dist.mjs",
    "check": "astro check",
    "cross-post": "node scripts/cross-post.mjs",
    "cross-post:test": "node --test scripts/cross-post.test.mjs",
    "dev": "astro dev",
    "license:check": "node scripts/license-validation.mjs",
    "license:check:all": "node scripts/license-validation.mjs --all",
    "license:fix": "node scripts/license-validation.mjs --fix",
    "license:test": "node --test scripts/license-validation.test.mjs",
    "release:check": "node scripts/check-release.mjs",
    "test": "npm run license:test && npm run cross-post:test",
    "validate": "node scripts/prepare-dist.mjs && node scripts/check-site.mjs && node scripts/check-content.mjs",
    "preview": "astro preview",
    "production:check": "node scripts/check-production.mjs",
    "workflow:check": "node scripts/check-workflows.mjs"
  }
}
