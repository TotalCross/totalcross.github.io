-->
<BaseLayout title={`${label} · TotalCross Blog`} description={`TotalCross articles in ${label}.`}><PageHero title={label} tagline="A TotalCross blog category" /><section class="page-content"><div class="container prose-wide"><PostList items={items} /></div></section></BaseLayout>
